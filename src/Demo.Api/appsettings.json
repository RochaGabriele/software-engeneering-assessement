{
  "ConnectionStrings": {
    "Demo": "Data Source=demo.db"
  },
  "ExchangeRates": {
    "TargetCurrencies": [ "EUR", "CAD", "GBP", "CHF" ],
    "Sync": {
      "Enabled": true,
      "Cron": "0 6 * * 1",
      "TimeZone": "UTC",
      "CatchUpOnStartup": true
    }
  },
  "OpenExchangeRates": {
    "BaseUrl": "https://openexchangerates.org/api/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
